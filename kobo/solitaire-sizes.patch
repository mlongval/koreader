+-- The status line in the largest font that fits the bar (about half its
+-- height), made smaller until the whole line fits across the screen.
+-- Font:getFace scales sizes by the screen's DPI itself.
+function SolitaireUI:statusText(text, max_w, bar_h)
+    local size = math.floor(bar_h * 0.6 * 1000 / Screen:scaleBySize(1000))
+    local widget
+    while true do
+        widget = TextWidget:new{ text = text, face = Font:getFace("scfont", size) }
+        if widget:getSize().w <= max_w or size <= 8 then return widget end
+        widget:free()
+        size = size - 1
+    end
+end
