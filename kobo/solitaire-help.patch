@@ -0,0 +1,60 @@
+--[[--
+Kobo fork: what each Solitaire button does, the explanation shown the first
+time it is used (solitairehelpdialog.lua), until "Do not show this again".
+
+@module solitaire.solitairehelptext
+--]]
+
+local _ = require("gettext")
+
+return {
+    -- The row of buttons
+    game = {
+        title = _("Game menu"),
+        text = _("Game ▾ opens the menu for the game:\n\n• New game: shuffle and deal a fresh game\n• Statistics: how many games you played and won, your best score, your quickest win\n• Leaderboard: your ten best won games\n• Reset statistics: start the counts over\n\nThe game you are playing is saved by itself, so you can close Solitaire and come back to it later."),
+    },
+    undo = {
+        title = _("Undo"),
+        text = _("Undo takes back your last move: the cards go back where they were.\n\nTap it again to go further back, as far as the start of the game. Use it to try another way when you get stuck.\n\nThe button is grey when there is nothing to take back."),
+    },
+    hint = {
+        title = _("Hint"),
+        text = _("Hint looks for a move you can make and marks the cards for two seconds: the card to move and where it can go.\n\nIf there is no move on the table, it tells you to turn over cards from the stock (the face-down pile at the top left)."),
+    },
+    auto = {
+        title = _("Auto"),
+        text = _("Auto sends up every card that can go onto the four piles at the top right (the foundations), one after another, until none can.\n\nEach foundation is built up by suit, from the Ace to the King. Near the end of a game Auto finishes it for you.\n\nTip: to send up just one card, tap it twice quickly, or hold your finger on it."),
+    },
+    refresh = {
+        title = _("Refresh"),
+        text = _("Refresh flashes the whole screen black and white once.\n\nE-ink keeps faint traces (ghosts) of what was on it before, especially after menus and dialogs. A flash clears them, so the cards look sharp again."),
+    },
+    options = {
+        title = _("Options"),
+        text = _("Options ▾ chooses how many cards you turn over from the stock at a time:\n\n• Draw 1 card: easier, most games can be won\n• Draw 3 cards: the classic, harder game; only the top card of the three can be played\n\nThe current choice has a ✓ and is also shown in the status line. Your choice is kept for next time."),
+    },
+
+    -- Game menu
+    new_game = {
+        title = _("New game"),
+        text = _("New game shuffles the cards and deals a fresh game straight away.\n\nThe goal: move all 52 cards onto the four piles at the top right, each suit from the Ace up to the King. On the table, build columns down in alternating colours (a red 6 on a black 7); only a King can go into an empty column.\n\nA game you had started and not won counts as lost in the statistics."),
+    },
+    stats = {
+        title = _("Statistics"),
+        text = _("Statistics shows your record: games played, won and lost, how often you win, your best and average score, your fewest moves and quickest time for a win, and your winning streaks.\n\nTap anywhere to close it."),
+    },
+    leaderboard = {
+        title = _("Leaderboard"),
+        text = _("The leaderboard lists your ten best won games by score, with the moves, the time and the draw mode of each.\n\nYou score points for cards played to the foundations and from the stock to the table, and lose some for turning the stock over again. Tap anywhere to close it."),
+    },
+    reset_stats = {
+        title = _("Reset statistics"),
+        text = _("Reset statistics clears all the counts and the leaderboard, to start over from nothing.\n\nYou are asked to confirm first, because it cannot be undone. The game you are playing is not touched."),
+    },
+
+    -- Options menu
+    draw_mode = {
+        title = _("Draw 1 or 3"),
+        text = _("This changes how many cards a tap on the stock turns over: one at a time, or three at a time with only the top one playable.\n\nThe change applies to the game on the table right away, and is kept for your next games.\n\nWhen the stock is empty, tap its place to turn the discarded cards back over and go through them again."),
+    },
+}
