+-- Kobo fork: the first time a button or menu item is used, a few words on
+-- what it does (solitairehelpdialog.lua), then fn.
+function SolitaireUI:explain(key, fn)
+    if not key then return fn() end
+    self.explained = self.explained or {}
+    require("solitairehelpdialog").explainOnce(self, self.settings_path, self.explained, key, fn)
+end
+
