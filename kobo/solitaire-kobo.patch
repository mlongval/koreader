+-- Framed buttons of equal width across the screen (as KoboChess's).
+function SolitaireUI:buttonRow(specs, margin)
+    local gap = Size.padding.default
+    local width = math.floor((self.screen_width - 2 * margin - gap * (#specs - 1)) / #specs)
+    local group = HorizontalGroup:new{ align = "center" }
+    for i, spec in ipairs(specs) do
+        table.insert(group, Button:new{
+            text = spec.text,
+            width = width,
+            enabled = spec.enabled ~= false,
+            callback = spec.callback,
+            show_parent = self,
+        })
+        if i < #specs then table.insert(group, HorizontalSpan:new{ width = gap }) end
+    end
+    return group
+end
+
+-- A menu as KoboChess shows them: a titled list of buttons.
+function SolitaireUI:showMenu(title, entries)
+    local dialog
+    local buttons = {}
+    for __, entry in ipairs(entries) do
+        table.insert(buttons, { {
+            text = entry.text,
+            callback = function()
+                UIManager:close(dialog)
+                entry.callback()
+            end,
+        } })
+    end
+    dialog = ButtonDialog:new{ title = title, title_align = "center", buttons = buttons }
+    UIManager:show(dialog)
+end
+
+function SolitaireUI:showGameMenu()
+    self:showMenu(_("Game"), {
+        { text = _("New game"), callback = function() self:newGame() end },
+        { text = _("Statistics"), callback = function() self:showStats() end },
+        { text = _("Leaderboard"), callback = function() self:showLeaderboard() end },
+        { text = _("Reset statistics"), callback = function() self:confirmResetStats() end },
+    })
+end
+
+function SolitaireUI:showOptionsMenu()
+    local three = self.game.draw_mode == 3
+    self:showMenu(_("Options"), {
+        { text = (three and "" or "✓ ") .. _("Draw 1 card"),
+          callback = function() if three then self:toggleDrawMode() end end },
+        { text = (three and "✓ " or "") .. _("Draw 3 cards"),
+          callback = function() if not three then self:toggleDrawMode() end end },
+    })
+end
