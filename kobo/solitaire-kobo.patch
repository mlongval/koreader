+-- Kobo fork: the device menu (mykobo.koplugin's kobo_devicemenu), if there.
+function SolitaireUI:onSwipe(arg, ges)
+    local ok, DeviceMenu = pcall(require, "kobo_devicemenu")
+    return ok and DeviceMenu.handleSwipe(ges, {
+        title = _("Solitaire"),
+        items = {
+            { text = _("Quit Solitaire"), callback = function() self:onClose() end },
+        },
+        close_app = function() self:onClose() end,
+        on_close = function() UIManager:setDirty(self, "full") end,
+    }) or false
+end
+
+function SolitaireUI:onTwoFingerSwipe(arg, ges)
+    local ok, DeviceMenu = pcall(require, "kobo_devicemenu")
+    return ok and DeviceMenu.lightGesture(ges) or false
+end
