+-- Kobo fork: the top card of the waste or of a column onto its suit's pile
+-- (an Ace, or the next card of a started suit). True if it went.
+function SolitaireUI:sendToFoundation(zone)
+    if not zone then return false end
+    local idx
+    if zone.type == "tableau" then
+        local col = self.game.tableau[zone.index]
+        if not col or zone.card_pos ~= #col then return false end
+        idx = zone.index
+    elseif zone.type ~= "waste" then
+        return false
+    end
+    for f = 1, 4 do
+        if self.game:moveToFoundation(zone.type, idx, f) then
+            self.game_started = true
+            self.selected_source = nil
+            self.hint_highlight = nil
+            self:saveGame()
+            if self.game:checkWin() then self:showWinMessage() end
+            self:refreshUI()
+            return true
+        end
+    end
+    return false
+end
+
+function SolitaireUI:onDoubleTap(arg, ges)
+    self:sendToFoundation(self:findTouchZone(ges.pos.x, ges.pos.y))
+    return true
+end
+
